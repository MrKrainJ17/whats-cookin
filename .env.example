# What's Cookin — environment variables. Copy this file to `.env.local`
# and fill in real values, then restart `npm run dev`.

# Anthropic API key for recipe generation + photo recognition.
# Get one at https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=

# Supabase project URL + anon key for auth.
# Create a project at https://supabase.com → Settings → API.
# Then in Authentication → URL Configuration, add
#   Site URL:       http://localhost:5173
#   Redirect URLs:  http://localhost:5173/auth/callback
#                   http://localhost:5173/reset-password
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
